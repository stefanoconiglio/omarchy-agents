#!/bin/sh
# A stand-in for claude-swap's `cswap`, for the tests: it logs its arguments
# to $CSWAP_STUB_LOG and answers `list --json` with the made-up seats in
# list.json beside it and `switch <n> --json` as cswap does. It switches
# nothing.
here="$(cd "$(dirname "$0")" && pwd)"
[ -n "${CSWAP_STUB_LOG:-}" ] && echo "$*" >> "$CSWAP_STUB_LOG"
case "$1" in
  list) cat "$here/list.json" ;;
  switch)
    if [ "$2" = 3 ]; then
      echo '{"schemaVersion":1,"error":{"type":"AccountNotFound","message":"No account 3"}}'
      exit 1
    fi
    printf '{"schemaVersion":1,"switched":true,"from":{"number":2},"to":{"number":%s},"reason":"switched","message":"Switched to Account-%s (stub)","warnings":[]}\n' "$2" "$2" ;;
  *) echo "cswap stub: $*" ;;
esac
